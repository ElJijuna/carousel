{
	"name": "@real-native/carousel",
	"version": "0.2.0",
	"description": "Headless, dependency-free horizontal carousel for React Native, Expo and react-native-web",
	"main": "./lib/commonjs/index.js",
	"module": "./lib/module/index.js",
	"types": "./lib/typescript/commonjs/index.d.ts",
	"react-native": "./src/index.ts",
	"source": "./src/index.ts",
	"exports": {
		".": {
			"react-native": "./src/index.ts",
			"import": {
				"types": "./lib/typescript/module/index.d.ts",
				"default": "./lib/module/index.js"
			},
			"require": {
				"types": "./lib/typescript/commonjs/index.d.ts",
				"default": "./lib/commonjs/index.js"
			}
		},
		"./package.json": "./package.json"
	},
	"files": [
		"lib",
		"src",
		"CHANGELOG.md",
		"!**/__tests__",
		"!**/*.test.ts",
		"!**/*.test.tsx",
		"!**/*.stories.ts",
		"!**/*.stories.tsx",
		"!**/stories"
	],
	"sideEffects": false,
	"scripts": {
		"build": "bob build",
		"typecheck": "tsc --noEmit && tsc --noEmit -p e2e/tsconfig.json",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"lint:md": "markdownlint-cli2 \"**/*.md\" \"!node_modules\" \"!docs\" \"!lib\" \"!CHANGELOG.md\"",
		"format": "biome check --write .",
		"format:check": "biome check .",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:coverage": "jest --coverage",
		"test:e2e": "playwright test",
		"storybook": "storybook dev -p 6006 --no-open",
		"build-storybook": "storybook build",
		"docs": "typedoc",
		"prepublishOnly": "npm run build"
	},
	"keywords": [
		"react-native",
		"expo",
		"carousel",
		"slider",
		"headless",
		"swiper",
		"pagination",
		"react-native-web"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ElJijuna/carousel.git"
	},
	"bugs": {
		"url": "https://github.com/ElJijuna/carousel/issues"
	},
	"homepage": "https://github.com/ElJijuna/carousel#readme",
	"author": "pilmee <pilmee@gmail.com> (https://github.com/ElJijuna)",
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {},
	"peerDependencies": {
		"react": ">=18.0.0",
		"react-native": ">=0.74.0"
	},
	"devDependencies": {
		"@babel/core": "^7.26.0",
		"@biomejs/biome": "^2.4.16",
		"@commitlint/cli": "^19.6.0",
		"@commitlint/config-conventional": "^19.6.0",
		"@playwright/test": "^1.49.0",
		"@react-native/babel-preset": "0.87.1",
		"@react-native/jest-preset": "0.87.1",
		"@react-native/typescript-config": "0.87.1",
		"@semantic-release/changelog": "^6.0.3",
		"@semantic-release/commit-analyzer": "^13.0.0",
		"@semantic-release/git": "^10.0.1",
		"@semantic-release/github": "^11.0.1",
		"@semantic-release/npm": "^12.0.1",
		"@semantic-release/release-notes-generator": "^14.0.1",
		"@storybook/addon-a11y": "^10.5.10",
		"@storybook/addon-docs": "^10.5.10",
		"@storybook/react": "^10.5.10",
		"@storybook/react-native-web-vite": "^10.5.10",
		"@testing-library/react-native": "^14.0.1",
		"@types/jest": "^29.5.14",
		"@types/node": "^22.10.0",
		"@types/react": "^19.1.1",
		"conventional-changelog-conventionalcommits": "^8.0.0",
		"eslint": "^10.9.1",
		"jest": "^29.7.0",
		"markdownlint-cli2": "^0.23.2",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"react-native": "0.87.1",
		"react-native-builder-bob": "^0.35.0",
		"react-native-web": "^0.21.2",
		"semantic-release": "^24.2.0",
		"storybook": "^10.5.10",
		"super-configs": "^1.24.0",
		"test-renderer": "^1.2.0",
		"typedoc": "^0.28.0",
		"typescript": "^5.9.0",
		"vite": "^8.0.0"
	},
	"react-native-builder-bob": {
		"source": "src",
		"output": "lib",
		"targets": [
			[
				"commonjs",
				{
					"esm": true
				}
			],
			[
				"module",
				{
					"esm": true
				}
			],
			[
				"typescript",
				{
					"project": "tsconfig.build.json",
					"esm": true
				}
			]
		],
		"exclude": "{**/{__tests__,__fixtures__,__mocks__,stories}/**,**/*.{spec,test,stories}.{ts,tsx}}"
	}
}
